# Copy this file to .env.local for local testing.
# In Vercel, add the same keys under Project > Settings > Environment Variables.

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=dream_visualizer

# Cloudinary: Dashboard > API environment variable
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_FOLDER=dream-visualizer

# Cloudflare Workers AI: account ID from the dashboard, token from the "Workers AI" template
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b

# Cloudflare Turnstile secret key. Leave empty to skip the security check while testing.
TURNSTILE_SECRET_KEY=

# Sites allowed to submit, comma separated, no trailing slash
ALLOWED_ORIGINS=https://dreamoutdoorliving.life,https://YOUR-STORE.myshopify.com

# Any long random string. Used to hash IP addresses so raw IPs are never stored.
IP_HASH_SALT=change-me-to-a-long-random-string

# Limits (protect the free AI allowance)
MAX_PER_EMAIL=2
MAX_PER_IP_PER_DAY=5
MAX_PER_DAY=40

# true = new designs go straight to the gallery (testing only). false = you approve them first.
AUTO_APPROVE=false

# Long side of the generated image in pixels (256-1920). Bigger uses more of the free allowance.
AI_OUTPUT_LONG_SIDE=1024
